# Frontend (Vite) variables — bundled into the browser at build time.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
# Local dev (uvicorn): http://localhost:8000/api
# Local docker / Vercel: /api  (same-origin reverse proxy)
VITE_API_URL=/api

# White-labeling & theming (optional).
VITE_BRAND_NAME=Nirmanam
# VITE_BRAND_LOGO=https://example.com/logo.png
VITE_THEME_ACCENT=#ef6f39

# Server-side FastAPI variables. Never expose these as VITE_* variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
FRONTEND_URL=http://localhost:8080

# Feature flags (optional). JSON object; anything omitted defaults to enabled.
# Flags: audit_log, categories, notes, signup.
FEATURE_FLAGS={"audit_log": true, "categories": true, "notes": true, "signup": true}
