VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
VITE_API_URL=http://localhost:8000/api

# Server-side FastAPI variables. Never expose these as VITE_* variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Feature flags (optional). JSON object; anything omitted defaults to enabled.
# Example: disable the audit log and notes features:
# FEATURE_FLAGS={"audit_log": false, "notes": false}
