# Frontend (Vite) variables — bundled into the browser at build time.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
# Local dev (uvicorn): http://localhost:8000/api
# Local docker / Vercel: /api  (same-origin reverse proxy)
VITE_API_URL=/api

# White-labeling & theming (optional).
VITE_BRAND_NAME=Nirmanam
# VITE_BRAND_LOGO=https://example.com/logo.png
VITE_THEME_ACCENT=#b8481a

# Server-side FastAPI variables. Never expose these as VITE_* variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Only for older projects that sign logins with the legacy JWT secret (newer
# projects publish signing keys and need nothing here). Skips an Auth round
# trip per request.
# SUPABASE_JWT_SECRET=
FRONTEND_URL=http://localhost:8080

# Feature flags (optional). JSON object; anything omitted defaults to enabled.
# Flags: audit_log, categories, notes, signup, scan, telegram.
FEATURE_FLAGS={"audit_log": true, "categories": true, "notes": true, "signup": true, "scan": true, "telegram": true}

# Telegram bot (optional): users send UPI screenshots, the bot adds them as
# site expenses. Create the bot with @BotFather, then run
#   TELEGRAM_BOT_TOKEN=... python3 scripts/setup_telegram.py --write-env
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Telegram sends this back on every webhook call (cloud only).
# TELEGRAM_WEBHOOK_SECRET=
# Screenshot dates fall back to the day the message was sent, in this zone.
# TELEGRAM_TIMEZONE=Asia/Kolkata
# Screenshot OCR service and its shared secret. On Vercel OCR_URL defaults to
# <production domain>/api/ocr; Docker sets it to the ocr service.
# OCR_URL=http://localhost:3001
# INTERNAL_API_SECRET=
