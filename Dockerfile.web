# syntax=docker/dockerfile:1
# Build the Vite frontend, then serve it with nginx (with /api reverse proxy).

FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html ./
COPY src ./src

# White-label / runtime config baked in at build time.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_URL=/api
ARG VITE_BRAND_NAME
ARG VITE_BRAND_LOGO
ARG VITE_THEME_ACCENT
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_API_URL=$VITE_API_URL \
    VITE_BRAND_NAME=$VITE_BRAND_NAME \
    VITE_BRAND_LOGO=$VITE_BRAND_LOGO \
    VITE_THEME_ACCENT=$VITE_THEME_ACCENT

RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
