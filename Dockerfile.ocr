# syntax=docker/dockerfile:1
# Screenshot OCR for the Telegram bot (server/ocr.js), for local Docker.
FROM node:22-slim

WORKDIR /app

# Install only what the OCR server needs, at the versions package.json pins.
COPY package.json ./
RUN node -e 'const p=require("./package.json");const d={};for(const k of ["sharp","tesseract.js"])d[k]=p.dependencies[k];require("fs").writeFileSync("package.json",JSON.stringify({type:"module",dependencies:d}))' \
  && npm install --omit=dev --no-audit --no-fund

COPY server ./server
COPY src/lib/upiParse.js ./src/lib/upiParse.js
COPY scripts/ocr-server.mjs ./scripts/ocr-server.mjs

EXPOSE 3001
CMD ["node", "scripts/ocr-server.mjs"]
